# ==============================================================================
# SCIENCE BUDDY — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to `.env` or `.env.local` for local development.
# DO NOT commit `.env` or actual secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Required for AI Tutor chat, subjective answer grading, and smart study recommendations.
# In Google AI Studio / Cloud Run, this is securely injected via backend environment secrets.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Application Host Configuration (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Base URL where the application or proxy server is hosted.
# Example: http://localhost:3000 (Local) or your Cloud Run service URL (Production)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database Configuration
# ------------------------------------------------------------------------------
# Connects Science Buddy to Supabase PostgreSQL for cloud sync and persistence.
# If omitted, Science Buddy operates gracefully in local offline browser storage mode.

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# Supabase Public Anon Key (Client-Safe, protected by Row Level Security)
SUPABASE_ANON_KEY=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Service Role Secret Key (SERVER-ONLY: Bypasses RLS for backend admin tasks)
# WARNING: NEVER expose this key in client code, HTML, or public bundles!
SUPABASE_SERVICE_ROLE_KEY=""
